{
  "realm": "cloud-cost-compass",
  "enabled": true,
  "displayName": "Cloud Cost Compass",
  "displayNameHtml": "<div class=\"kc-logo-text\"><span>Cloud Cost Compass</span></div>",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "clients": [
    {
      "clientId": "cloud-cost-compass",
      "enabled": true,
      "name": "Cloud Cost Compass Application",
      "description": "Main application client",
      "redirectUris": [
        "http://localhost:8501/*",
        "https://cloud-cost-compass.example.com/*"
      ],
      "webOrigins": [
        "http://localhost:8501",
        "https://cloud-cost-compass.example.com"
      ],
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "web-origins",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone"
      ]
    },
    {
      "clientId": "mcp-server",
      "enabled": true,
      "name": "MCP Server",
      "description": "MCP Server client for agent access",
      "redirectUris": [
        "http://mcp-server:8000/*"
      ],
      "webOrigins": [
        "http://mcp-server:8000"
      ],
      "publicClient": false,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "bearerOnly": true,
      "protocol": "openid-connect"
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Administrator role"
      },
      {
        "name": "user",
        "description": "Standard user role"
      },
      {
        "name": "tenant-admin",
        "description": "Tenant administrator role"
      }
    ]
  },
  "defaultRoles": ["user"],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@example.com",
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "admin"
        }
      ],
      "realmRoles": ["admin", "user"]
    }
  ],
  "identityProvider": {
    "type": "oidc",
    "provider": "keycloak",
    "config": {}
  },
  "clientScopes": [
    {
      "name": "profile",
      "type": "default",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.response": true,
        "display.on.consent.screen": true
      },
      "protocolMapper": {
        "name": "profile",
        "type": "oidc",
        "config": {
          "user.attribute": "profile",
          "claim.name": "profile"
        }
      }
    },
    {
      "name": "roles",
      "type": "default",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.response": true,
        "display.on.consent.screen": true
      }
    },
    {
      "name": "email",
      "type": "default",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.response": true,
        "display.on.consent.screen": true
      }
    }
  ],
  "securitySettings": {
    "bruteForceProtected": true,
    "permanentLockout": false,
    "maxFailure": 5,
    "waitIncrementSeconds": 60,
    "minimumQuickLoginWaitSeconds": 30,
    "failureFactor": 2
  },
  "attributeConsentSettings": {
    "skipConsent": true
  }
}